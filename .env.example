# ─────────────────────────────────────────────────────────────────────────────
# Novella Environment Variables Template
# Copy this file to `.env.local` for local development.
# For production (e.g. Vercel), add these variables in your host's dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. App Configuration ─────────────────────────────────────────────────────
# Local development: http://localhost:3000
# Production: https://yourdomain.com (or https://your-project.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── 2. Database (Prisma + Neon) ──────────────────────────────────────────────
# Use the POOLED connection URL for runtime queries (required with Neon + Prisma):
DATABASE_URL="postgresql://user:password@ep-cool-snowflake-12345-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Use the DIRECT (unpooled) connection URL for Prisma migrations (db push / migrate):
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-cool-snowflake-12345.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── 3. Firebase Authentication (Client-side) ──────────────────────────────────
# Found in: Firebase Console > Project Settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── 4. Firebase Admin SDK (Server-side) ───────────────────────────────────────
# Found in: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Keep the quotes and literal \n characters if pasting a multiline private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ── 5. AI Vocabulary Lookup (Groq) ───────────────────────────────────────────
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# ── 6. Cloudinary Image Storage (Book Covers) ─────────────────────────────────
# Get credentials at: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── 7. Upstash Redis (Rate Limiting & AI Cache) ──────────────────────────────
# Optional for local dev (falls back to in-memory store).
# Recommended for production: get a free database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Standard Redis alternative (if self-hosting Redis):
# REDIS_URL=redis://localhost:6379

# ── 8. Cloudflare Turnstile (Bot & Brute-Force Protection) ────────────────────
# Optional in dev (skips verification if unset).
# Get keys at: https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── 9. Email Notifications & OTP Delivery (Nodemailer SMTP) ───────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Email address where user glitch/feedback reports are delivered:
REPORT_NOTIFY_EMAIL=admin@yourdomain.com

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
# Create a project at https://sentry.io → Settings → Projects → DSN
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for source map uploads: https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=
# Sentry org slug (from your Sentry URL: https://sentry.io/organizations/<slug>/)
SENTRY_ORG=
# Sentry project slug
SENTRY_PROJECT=

# ── PostHog (Product Analytics) ───────────────────────────────────────────────
# Project token: PostHog → Project settings → Project API key
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
# US Cloud: https://us.i.posthog.com | EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
